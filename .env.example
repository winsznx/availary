# Worker / server-only secrets (never prefixed VITE_, never sent to the browser)
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
AVAILARY_LIVE_CALLS=false
# Comma-separated E.164 numbers CALL-E may dial while live calls are on.
AVAILARY_DEMO_ALLOWLIST=

# Supabase dashboard: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
# service_role key — bypasses RLS, server-only, never prefix VITE_
SUPABASE_SERVICE_ROLE_KEY=
# generate with: openssl rand -base64 32
PHONE_ENCRYPTION_KEY=
# Comma-separated allowed CORS origins, e.g. http://localhost:5173,https://availary.example.com
APP_ORIGIN=http://localhost:5173

# Frontend (Vite) — anon key only, safe for the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8787
